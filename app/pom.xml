                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-core</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>com.vaadin</groupId>
                            <artifactId>vaadin-dev</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>com.vaadin</groupId>
						<artifactId>vaadin-maven-plugin</artifactId>
						<version>${vaadin.version}</version>
						<executions>
							<execution>
								<id>frontend</id>
								<phase>compile</phase>
								<goals>
									<goal>build-frontend</goal>
								</goals>
								<configuration>
                                    <forceProductionBuild>true</forceProductionBuild>
									<optimizeBundle>false</optimizeBundle>
                                </configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- we use this profile to take advantage of the java version configured in toolchains -->
		<profile>
			<id>run</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.1</version>
						<executions>
							<execution>
								<id>run-boot-jar</id>
								<phase>validate</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>java</executable>
									<arguments>
										<argument>-jar</argument>
										<argument>target/calendarAggregator-${project.version}-boot.jar</argument>
										<argument>--logging.level.org.springframework.boot.context.config=TRACE</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<id>run-test-main</id>
								<phase>validate</phase>
								<goals>
									<goal>java</goal>
								</goals>
								<configuration>
									<mainClass>nl.softworks.calendarAggregator.CalendarAggregatorApplicationPostgres</mainClass>
									<classpathScope>test</classpathScope>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>container</id>
			<properties>
				<containerImageId>org.tbee.calendaraggregator/calendaraggregator</containerImageId>
			</properties>
			<build>
				<plugins>
					<!--
					     Shared configuration for building the container image using Jib.

					     - container-local:  jib:dockerBuild @ package -> builds into the local
					       Docker daemon, no push. Used by mvn_buildContainer.cmd.
					     - container-remote: jib:build @ install -> builds and pushes to the
					       nexus registry. Used by mvn_pushContainer.cmd.

					     Registry credentials are taken from ~/.m2/settings.xml, from the
					     <server> whose <id> matches the registry host (nexus.softworks.nl).
					-->
					<plugin>
						<groupId>com.google.cloud.tools</groupId>
						<artifactId>jib-maven-plugin</artifactId>
						<version>3.5.2</version>
						<configuration>
							<from>
								<image>eclipse-temurin:25-jre-alpine</image>
							</from>
							<to>
								<image>nexus.softworks.nl/docker-private/${containerImageId}:${project.version}</image>
								<tags>
									<tag>latest</tag>
								</tags>
							</to>
							<container>
								<mainClass>nl.softworks.calendarAggregator.CalendarAggregateApplication</mainClass>
								<jvmFlags>
									<jvmFlag>-Dlogging.config=file:/data/logback.xml</jvmFlag>
									<jvmFlag>-Dlogback.configurationFile=file:/data/logback.xml</jvmFlag>
									<jvmFlag>-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005</jvmFlag>
								</jvmFlags>
								<ports>
									<port>8080</port>
									<port>5005</port>
								</ports>
								<!-- non-root user (UID/GID 1000) -->
								<user>1000:1000</user>
								<workingDirectory>/data</workingDirectory>
								<creationTime>USE_CURRENT_TIMESTAMP</creationTime>
							</container>
							<extraDirectories>
								<paths>
									<path>
										<from>${project.basedir}/src/main/container</from>
										<includes>
											<include>logback.xml</include>
										</includes>
										<into>/data</into>
									</path>
								</paths>
							</extraDirectories>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- See the container profile: binds jib:dockerBuild -> build into the local Docker daemon. -->
		<profile>
			<id>container-local</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.google.cloud.tools</groupId>
						<artifactId>jib-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>build-container-local</id>
								<phase>package</phase>
								<goals>
									<goal>dockerBuild</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- See the container profile: binds jib:build -> build and push to the nexus registry
		     (no local Docker daemon required). -->
		<profile>
			<id>container-remote</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.google.cloud.tools</groupId>
						<artifactId>jib-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>build-and-push-container</id>
								<phase>install</phase>
								<goals>
									<goal>build</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
